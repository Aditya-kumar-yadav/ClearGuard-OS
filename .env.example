# AuroraPay OS Environment Configuration

# PayPal Developer Sandbox Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Database
DATABASE_URL=postgresql://aurora_user:aurora_pass@localhost:5432/aurorapay_db

# Security & Environment Configuration (Stage 5B Hardened)
APP_ENV=development
ENVIRONMENT=development
CLEARGUARD_AUTH_SECRET=your_32_character_clearguard_auth_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
ALLOW_WEBHOOK_SIMULATION=false

# Security & OpenGuardrails
OPEN_GUARDRAILS_RULES_PATH=C:\Users\bitd\Downloads\openguardrails\cli\rules\secrets.json

# Service Endpoints
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
PAYPAL_RETURN_URL=http://localhost:3000/escrow/return
PAYPAL_CANCEL_URL=http://localhost:3000/escrow/cancel

